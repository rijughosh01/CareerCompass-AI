# ==============================================================================
# CareerCompass AI - Backend Environment Variables
# ==============================================================================

PROJECT_NAME="CareerCompass AI"
API_V1_STR="/api"

# Security & JWT
SECRET_KEY="change-this-to-a-strong-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional AI LLM Service (Gemini API Key for AI Counselor enhancement)
GEMINI_API_KEY=""

# Database Configuration
# Default: SQLite for immediate development & evaluation
# Production: Change to PostgreSQL: postgresql://username:password@localhost:5432/careercompass_db
DATABASE_URL="sqlite:///./careercompass.db"

# CORS Configuration (Comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ML Model Artifact Path (relative to backend directory or absolute path)
MODEL_PATH="../ml_artifacts/careercompass_final_model.joblib"
UPLOAD_DIR="./uploads"

