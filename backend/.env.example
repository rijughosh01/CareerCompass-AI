# ============================================================
# CareerCompass AI - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control!
# ============================================================

# --- Core Settings ---
SECRET_KEY=careercompass-ai-super-secret-production-quality-jwt-token-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./careercompass.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/careercompass

# --- AI / LLM Integration ---
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# --- Monitoring & Observability ---
# Optional: Get a free Sentry DSN at https://sentry.io/
SENTRY_DSN=
# Optional: Redis for production caching
REDIS_URL=
# development | staging | production
ENVIRONMENT=development

# --- CORS (comma-separated origins for production) ---
# CORS_ORIGINS=["https://your-domain.com"]
